{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "manual",
  "unstable": ["fmt-component", "kv"],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test --allow-env lib",
    "dev": "IAM_PAGER_SESSION_COOKIE_MODE=local IAM_PAGER_GOOGLE_AUTH_MODE=local IAM_PAGER_GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback IAM_PAGER_GOOGLE_AUTH_MOCK_CONSENT_URL=http://localhost:5173/auth/google/mock-consent vite",
    "build": "vite build",
    "start": "deno run -A server.ts",
    "update": "deno run -A -r jsr:@fresh/update .",
    "pre-deploy": {
      "description": "Verify and upgrade before deployment",
      "dependencies": ["pre-deploy::upgrade-db-schema"]
    },
    "pre-deploy::check": {
      "description": "Run formatting, lint, and type checks",
      "command": "deno task check"
    },
    "pre-deploy::test": {
      "description": "Run the complete test suite",
      "command": "deno task test"
    },
    "pre-deploy::build": {
      "description": "Build production output",
      "command": "deno task build"
    },
    "pre-deploy::upgrade-db-schema": {
      "description": "Apply missing forward database-schema upgrades",
      "command": "deno run --allow-env=IAM_PAGER_OWNERSHIP_STORAGE_BACKEND,IAM_PAGER_OWNERSHIP_DENO_KV_PATH,IAM_PAGER_SESSION_STORAGE_BACKEND,IAM_PAGER_CONTENT_STORAGE_BACKEND --allow-read --allow-write scripts/pre-deploy/upgrade-db-schema.ts",
      "dependencies": [
        "pre-deploy::check",
        "pre-deploy::test",
        "pre-deploy::build"
      ]
    }
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*", "tasks/**"],
  "imports": {
    "@/": "./",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@kindkitchen/gauth": "jsr:@kindkitchen/gauth@0.4.1",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/http/cookie": "jsr:@std/http@^1.0.21/cookie",
    "@std/http/status": "jsr:@std/http@^1.0.21/status",
    "effect": "npm:effect@^4.0.0-beta.91",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "marked": "npm:marked@^17.0.6",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
