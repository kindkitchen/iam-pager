{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "manual",
  "unstable": ["fmt-component", "kv"],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test --allow-env lib",
    "dev": "IAM_PAGER_SESSION_COOKIE_MODE=local IAM_PAGER_GOOGLE_AUTH_MODE=local IAM_PAGER_GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback IAM_PAGER_GOOGLE_AUTH_MOCK_CONSENT_URL=http://localhost:5173/auth/google/mock-consent vite",
    "build": "vite build",
    "start": "deno run -A server.ts",
    "update": "deno run -A -r jsr:@fresh/update .",
    "verify": {
      "description": "Run developer checks before push or review",
      "dependencies": ["check", "test"]
    },
    "hooks:install": {
      "description": "Install the tracked native pre-push hook",
      "command": "deno run --allow-run=git --allow-read --allow-write scripts/git-hooks/install.ts"
    },
    "pre-deploy": {
      "description": "Deployment placeholder with no checks or database work",
      "command": "echo \"pre-deploy: no automated checks; run deno task db:check manually when database schema changes\""
    },
    "db:check": {
      "description": "Manually inspect one explicit database schema target",
      "command": "deno run --allow-env=DENO_KV_ACCESS_TOKEN --allow-net --allow-read --allow-write scripts/database/schema.ts check"
    },
    "db:update": {
      "description": "Manually apply retained migrations to one explicit database",
      "command": "deno run --allow-env=DENO_KV_ACCESS_TOKEN --allow-net --allow-read --allow-write scripts/database/schema.ts update"
    }
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*", "tasks/**"],
  "imports": {
    "@/": "./",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@kindkitchen/gauth": "jsr:@kindkitchen/gauth@0.4.1",
    "@olli/kvdex": "jsr:@olli/kvdex@3.6.7",
    "@olli/kvdex/encoding/v8": "jsr:@olli/kvdex@3.6.7/encoding/v8",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/http/cookie": "jsr:@std/http@^1.0.21/cookie",
    "@std/http/status": "jsr:@std/http@^1.0.21/status",
    "effect": "npm:effect@^4.0.0-beta.91",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "marked": "npm:marked@^17.0.6",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "@types/he": "npm:@types/he@^1.2.3",
    "@types/prismjs": "npm:@types/prismjs@^1.26.6",
    "@types/sanitize-html": "npm:@types/sanitize-html@^2.16.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client",
      "@types/he",
      "@types/prismjs",
      "@types/sanitize-html"
    ]
  }
}
