# Complete iam-pager environment catalog.
#
# This file is intentionally tracked and contains no credentials. Copy it to
# .env.production.local (gitignored), replace every placeholder, and keep that
# private copy out of version control.
#
# "Context" and "Type" comments describe Deno Deploy configuration. They are
# documentation only: dotenv importers ignore comments and cannot apply context
# metadata. No iam-pager variable is needed in Deno Deploy's Build context.

# Core runtime ----------------------------------------------------------------

# Context: Production and Development runtime. Type: plain text.
# Optional but recommended explicitly. Use "production" on HTTPS deployments;
# "local" is only for loopback development.
IAM_PAGER_SESSION_COOKIE_MODE=production

# Context: Production and Development runtime. Type: plain text.
# Required. Use "original" for real Google sign-in; "local" is mock-only.
IAM_PAGER_GOOGLE_AUTH_MODE=original

# Context: the matching Production or Development runtime. Type: plain text.
# Required unless local mode uses a request-host pattern. The path is fixed.
IAM_PAGER_GOOGLE_AUTH_REDIRECT_URI=https://example.com/auth/google/callback

# Context: Production and Development runtime. Type: plain text.
# Required in original mode. A Google OAuth client ID is public metadata.
IAM_PAGER_GOOGLE_AUTH_CLIENT_ID=replace-with-google-client-id

# Context: Production and Development runtime. Type: secret.
# Required in original mode. Use the sign-in OAuth client's secret.
IAM_PAGER_GOOGLE_AUTH_CLIENT_SECRET=replace-with-google-client-secret

# Context: Development runtime, or another explicitly designated HTTPS preview.
# Type: plain text. Optional; full-host regular expression, at most 512 chars.
# IAM_PAGER_GOOGLE_AUTH_REQUEST_HOST_PATTERN=iam-pager-pr-[a-z0-9-]+\.example\.com

# Context: static local process only. Type: plain text. Omit this when an
# explicitly isolated HTTPS preview derives mock consent from a host pattern.
# IAM_PAGER_GOOGLE_AUTH_MOCK_CONSENT_URL=http://localhost:5173/auth/google/mock-consent

# Google Drive OAuth -----------------------------------------------------------

# Context: Production and Development runtime. Type: plain text.
# Required. Use "original" for Drive; "local" provides mock consent only.
# For a credential-free HTTPS preview, change this to "local", set the auth
# request-host pattern above, and omit the redirect, mock URL, ID, and secret.
IAM_PAGER_GOOGLE_DRIVE_MODE=original

# Context: the matching Production or Development runtime. Type: plain text.
# Required unless local mode inherits the auth host pattern or uses the Drive
# override below. The path is fixed.
IAM_PAGER_GOOGLE_DRIVE_REDIRECT_URI=https://example.com/auth/storage/google-drive/callback

# Context: Production and Development runtime. Type: plain text.
# Required in original mode. Use a separate Drive OAuth client from sign-in.
IAM_PAGER_GOOGLE_DRIVE_CLIENT_ID=replace-with-google-drive-client-id

# Context: Production and Development runtime. Type: secret.
# Required in original mode. Use the Drive OAuth client's secret.
IAM_PAGER_GOOGLE_DRIVE_CLIENT_SECRET=replace-with-google-drive-client-secret

# Context: Development runtime, or another explicitly designated HTTPS preview.
# Type: plain text. Optional local-mode override of the inherited auth full-host
# regular expression, at most 512 chars. The matched request supplies the origin.
# IAM_PAGER_GOOGLE_DRIVE_REQUEST_HOST_PATTERN=iam-pager-drive-pr-[a-z0-9-]+\.example\.com

# Context: static local process only. Type: plain text. Omit this when an
# explicitly isolated HTTPS preview derives mock consent from a host pattern.
# IAM_PAGER_GOOGLE_DRIVE_MOCK_CONSENT_URL=http://localhost:5173/auth/storage/google-drive/mock-consent

# Persistence -----------------------------------------------------------------

# Context: Production and Development runtime. Type: plain text.
# Required. Deno Deploy should use "deno-kv" with an attached database.
IAM_PAGER_OWNERSHIP_STORAGE_BACKEND=deno-kv

# Context: Production and Development runtime. Type: plain text.
# Required. Durable sessions must share durable ownership.
IAM_PAGER_SESSION_STORAGE_BACKEND=deno-kv

# Context: Production and Development runtime. Type: plain text.
# Required. Durable pages must share durable ownership.
IAM_PAGER_PAGE_STORAGE_BACKEND=deno-kv

# Context: Production and Development runtime. Type: plain text.
# Optional; unset inherits ownership. Values: "memory" or "deno-kv".
# IAM_PAGER_API_KEY_STORAGE_BACKEND=deno-kv

# Context: Production and Development runtime. Type: plain text.
# Optional; unset inherits ownership. Values: "memory" or "deno-kv".
# IAM_PAGER_STORAGE_CONNECTION_BACKEND=deno-kv

# Context: Production and Development runtime. Type: secret.
# Required whenever storage connections resolve to deno-kv. Supply a stable,
# canonical, unpadded base64url encoding of exactly 32 random bytes.
IAM_PAGER_STORAGE_TOKEN_KEY=replace-with-32-byte-base64url-key

# Context: self-hosted runtime only. Type: plain text unless the URL itself
# embeds credentials. On Deno Deploy, omit this to use the attached database.
# IAM_PAGER_OWNERSHIP_DENO_KV_PATH=https://api.deno.com/v2/databases/replace-with-database-id/connect

# Context: self-hosted runtime using remote Deno KV only. Type: secret.
# Deno Deploy does not accept this custom DENO_ key; attached KV needs no token.
# DENO_KV_ACCESS_TOKEN=replace-with-deno-kv-access-token

# Context: none for current application configuration. Type: plain text.
# Recognized only as a legacy diagnostic hint; it never selects repositories.
# DENO_KV_ID=replace-with-database-id

# Context: legacy Production or Development deployments only. Type: plain text.
# Deprecated page selector. Prefer IAM_PAGER_PAGE_STORAGE_BACKEND; if both are
# present, their values must match.
# IAM_PAGER_CONTENT_STORAGE_BACKEND=deno-kv

# Self-hosted server -----------------------------------------------------------

# Context: local or self-hosted runtime only. Type: plain text.
# Optional integer from 0 through 65535. Deno Deploy manages its own listener.
# PORT=8000
