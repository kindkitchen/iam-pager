# Local development (`deno task dev` supplies these values automatically).
IAM_PAGER_SESSION_COOKIE_MODE=local
IAM_PAGER_GOOGLE_AUTH_MODE=local
IAM_PAGER_GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
IAM_PAGER_GOOGLE_AUTH_MOCK_CONSENT_URL=http://localhost:5173/auth/google/mock-consent
IAM_PAGER_GOOGLE_DRIVE_MODE=local
IAM_PAGER_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/auth/storage/google-drive/callback
IAM_PAGER_GOOGLE_DRIVE_MOCK_CONSENT_URL=http://localhost:5173/auth/storage/google-drive/mock-consent
IAM_PAGER_OWNERSHIP_STORAGE_BACKEND=memory
IAM_PAGER_SESSION_STORAGE_BACKEND=memory
IAM_PAGER_PAGE_STORAGE_BACKEND=memory

# Production uses two separate Google Cloud OAuth clients.
# IAM_PAGER_SESSION_COOKIE_MODE=production
# IAM_PAGER_GOOGLE_AUTH_MODE=original
# IAM_PAGER_GOOGLE_AUTH_REDIRECT_URI=https://example.com/auth/google/callback
# IAM_PAGER_GOOGLE_AUTH_CLIENT_ID=...
# IAM_PAGER_GOOGLE_AUTH_CLIENT_SECRET=...
# IAM_PAGER_GOOGLE_DRIVE_MODE=original
# IAM_PAGER_GOOGLE_DRIVE_REDIRECT_URI=https://example.com/auth/storage/google-drive/callback
# IAM_PAGER_GOOGLE_DRIVE_CLIENT_ID=...
# IAM_PAGER_GOOGLE_DRIVE_CLIENT_SECRET=...

# Production storage selection is mandatory. Durable sessions, pages, API keys,
# and storage connections share the ownership database. On Deno Deploy, omit the
# path to use the attached database. Outside Deploy, use the complete remote
# connection URL; DENO_KV_ID and DENO_KV_ACCESS_TOKEN alone do not select stores.
# IAM_PAGER_OWNERSHIP_STORAGE_BACKEND=deno-kv
# IAM_PAGER_SESSION_STORAGE_BACKEND=deno-kv
# IAM_PAGER_PAGE_STORAGE_BACKEND=deno-kv
# IAM_PAGER_OWNERSHIP_DENO_KV_PATH=https://api.deno.com/v2/databases/<database-id>/connect
# DENO_KV_ACCESS_TOKEN=...
#
# Durable storage connections also require a separate canonical unpadded
# base64url-encoded 256-bit token-custody key.
# IAM_PAGER_STORAGE_TOKEN_KEY=...
